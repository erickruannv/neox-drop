# Somente local. Nenhuma credencial é necessária para iniciar FastAPI ou executar pytest.
APP_ENV=local
ALLOWED_ORIGIN=http://127.0.0.1:8000
# Habilitar SOMENTE após autorização e conferência dos destinos de teste (APP_ENV=test).
# O flag não verifica se uma credencial pertence a produção; conferir manualmente.
TEST_CONNECTIONS_ENABLED=false

# Chave publishable/anon de TESTE; nenhuma service_role é necessária nesta fundação.
SUPABASE_URL=
SUPABASE_KEY=
MONGODB_URI=
MONGODB_DATABASE=neox_drop_test
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

REQUEST_TIMEOUT_SECONDS=3
REDIS_TIMEOUT_SECONDS=1
MAX_REQUEST_BYTES=65536
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=5
# Taxas são por IP/processo local; não usar como proteção multiworker.
MEDIA_ALLOWED_ORIGINS=[]
# TTLs normativos: não ajustar sem revisão do contrato/plano.
CACHE_TTL_SECONDS=300
RECENT_TTL_SECONDS=604800
# Contato WhatsApp virá do singleton store_settings; nenhum número fictício aqui.

# Gerar localmente com secrets.token_urlsafe(48); nunca commitar o valor real.
COOKIE_SECRET=
CSRF_TTL_SECONDS=3600
ADMIN_REFRESH_MAX_AGE_SECONDS=604800

# Somente backend de TESTE: secret/service_role opcional para ler store_settings no checkout.
# Não é usada no login/perfil; nunca enviar ao browser ou incluir em logs.
SUPABASE_SECRET_KEY=

# Apenas testes reais: dados das DUAS contas fictícias do projeto Supabase de teste.
# Após opt-in explícito, testes leem contas do .env privado; ambiente do processo tem precedência.
NEOX_TEST_ADMIN_EMAIL=
NEOX_TEST_ADMIN_PASSWORD=
NEOX_TEST_NONADMIN_EMAIL=
NEOX_TEST_NONADMIN_PASSWORD=
# Opt-in deve ser explícito no PROCESSO, não é carregado automaticamente do .env pelos testes.
RUN_REAL_INTEGRATION=0
