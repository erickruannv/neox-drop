# NEOX drop — EXEMPLO. Não incluir segredos reais neste arquivo.
APP_ENV=development
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# Necessário para assinar cookies/sessões; GERAR aleatoriamente por ambiente.
COOKIE_SECRET=

# Supabase Auth + PostgreSQL
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Usar apenas se estritamente necessário e exclusivamente no backend:
SUPABASE_SECRET_KEY=

# MongoDB Atlas (servidor somente)
MONGODB_URI=
MONGODB_DB_NAME=neox_drop

# Redis Upstash REST (servidor somente)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# DDD + telefone internacional, SOMENTE dígitos (sem +)
STORE_WHATSAPP_NUMBER=
